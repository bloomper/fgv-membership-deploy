DEPLOY_ENV=staging
# Staging is reached through a Cloudflare Tunnel (see README)
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
# The Cloudflare Tunnel connector's image tag, pinned; upgrade it deliberately
CLOUDFLARED_VERSION=2026.11.0

# The web; fgv-infra-deploy's .env names it MEMBERSHIP_WEB_HOST. Keycloak's MEMBERSHIP_URL is https:// plus this
WEB_HOST=membership-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-membership-server:develop
WEB_IMAGE=bloomper/fgv-membership-web:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=membership
MYSQL_USER=membership

# Registration. The site key is public; the secret key is secrets/TURNSTILE_SECRET_KEY.
# Cloudflare's test site key 1x00000000000000000000AA always passes
TURNSTILE_SITE_KEY=
# Who is told when a new user has verified their address; comma separated
REGISTRATION_NOTIFY_RECIPIENTS=admin@example.org

# The mail relay: the same as Keycloak's
SMTP_HOST=smtp.example.org
SMTP_PORT=25
SMTP_FROM=noreply@example.org
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
