DEPLOY_ENV=staging
# Staging is reached through a Cloudflare Tunnel (see README)
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
# The Cloudflare Tunnel connector's image tag, pinned; upgrade it deliberately
CLOUDFLARED_VERSION=2026.11.0

# The web; fgv-infra-deploy's .env names it MEMBERSHIP_WEB_HOST. Keycloak's MEMBERSHIP_URL is https:// plus this
WEB_HOST=membership-staging.example.org
# The API's own hostname, for applications outside FGV's network that call it (payments told by other applications, and the like)
API_HOST=membership-api-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-membership-server:develop
WEB_IMAGE=bloomper/fgv-membership-web:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=membership
MYSQL_USER=membership

# Registration. The site key is public; the secret key is secrets/TURNSTILE_SECRET_KEY.
# Cloudflare's test site key 1x00000000000000000000AA always passes
TURNSTILE_SITE_KEY=
# Who is told when a new user has verified their address; comma separated
REGISTRATION_NOTIFY_RECIPIENTS=admin@example.org

# The mail relay: the same as Keycloak's
SMTP_HOST=smtp.example.org
SMTP_PORT=25
SMTP_FROM=noreply@example.org
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false

# Where members pay: FGV's Swish number (digits, spaces allowed), FGV's bankgiro, and a bank account for direct transfers (may stay empty)
SWISH_NUMBER=
BANKGIRO=
BANK_ACCOUNT=

# Where the other FGV applications are, for the switcher in the header (optional; Spexregister's also gives the link from a
# member to the spexare there)
SPEXREGISTER_WEB_URL=
REVIVAL_WEB_URL=
SPEXIPEDIA_WEB_URL=
SPEXIFY_WEB_URL=
SPEXFLIX_WEB_URL=
SPEXGRAM_WEB_URL=
ARCHIVE_WEB_URL=

# Shown on the support and about pages
SUPPORT_EMAIL=support.membership@fgv.nu
FEEDBACK_EMAIL=feedback.membership@fgv.nu

# Visitor statistics (optional): the website id Umami made for this application
UMAMI_WEBSITE_ID=

# Keycloak clients whose tokens the API accepts; add another application that tells about payments (comma separated)
#API_AUTHORIZED_PARTIES=fgv-membership,fgv-spexregister-service,fgv-revival-service,fgv-external-payment-service
